{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudattrib.local/schema/rule-bundle.schema.json",
  "title": "Rule bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers", "products", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "providers": {
	  "type": "array",
	  "items": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}}
	},
	"products": {
	  "type": "array",
	  "items": {"type": "object", "additionalProperties": false, "required": ["id", "relations"], "properties": {"id": {"type": "string"}, "provider_id": {"type": "string"}, "relations": {"type": "array", "items": {"type": "string"}}}}
	},
	"rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
		"required": ["id", "signal", "field", "match", "emit", "source_refs", "reviewed_at"],
        "properties": {
          "id": {"type": "string"},
          "signal": {"enum": ["dns", "http", "technology"]},
          "field": {"type": "string"},
		  "rrtype": {"type": "string"},
		  "match": {"type": "object"},
		  "emit": {"type": "object"},
		  "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reviewed_at": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
