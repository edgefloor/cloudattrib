{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudattrib.local/schema/analyze-request.schema.json",
  "title": "Analyze request",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "kind"],
  "properties": {
    "target": {"type": "string", "minLength": 1, "maxLength": 8192},
    "kind": {"enum": ["domain", "url", "ip"]},
    "mode": {"enum": ["full", "dns", "ip", "reclassify"]},
    "include_www": {"type": "boolean"},
    "additional_hostnames": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "scope_roots": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "ct_discovery": {"type": "boolean"},
    "organization_label": {"type": "string", "maxLength": 512}
  }
}
