{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudattrib.local/schema/report.schema.json",
  "title": "Attribution report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "target", "mode", "started_at", "ended_at", "classified_at", "bundle_id", "build_id", "status", "observations", "evidence", "findings", "coverage", "warnings"],
  "properties": {
    "schema_version": {"const": "1"},
    "content_id_version": {"const": "1"},
    "report_id": {"type": "string", "minLength": 1},
    "original_report_id": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "canonical", "kind"],
      "properties": {
        "original": {"type": "string"},
        "canonical": {"type": "string"},
        "kind": {"enum": ["domain", "url", "ip"]}
      }
    },
    "mode": {"enum": ["full", "dns", "ip", "reclassify"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "classified_at": {"type": "string", "format": "date-time"},
    "bundle_id": {"type": "string"},
    "build_id": {"type": "string"},
    "status": {"enum": ["complete", "partial", "failed", "cancelled"]},
    "observations": {"type": "array", "items": {"$ref": "observation.schema.json"}},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "status", "attempted", "completed", "truncated", "omitted"],
      "properties": {
        "capability": {"type": "string"},
        "status": {"enum": ["complete", "partial", "unavailable", "skipped"]},
        "attempted": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "error_codes": {"type": "array", "items": {"type": "string"}},
        "truncated": {"type": "integer", "minimum": 0},
        "omitted": {"type": "integer", "minimum": 0},
        "data_age_seconds": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      }
    }
  }
}
